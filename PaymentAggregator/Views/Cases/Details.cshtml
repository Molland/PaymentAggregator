@model PaymentAggregator.Models.Case
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var similarCases = ViewBag.SimilarCases as List<PaymentAggregator.Models.Case>;
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="toast-notification success" id="toast">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="toast-notification error" id="toast">@TempData["ErrorMessage"]</div>
}

<article class="case-article">
    <div class="article-header">
        <div class="case-meta" style="justify-content: flex-start; gap: 15px; margin-bottom: 15px;">
            <span class="case-badge">@Model.Category</span>
            <span class="case-date">@Model.CreatedDate.ToString("dd.MM.yyyy")</span>
        </div>
        <h1 class="page-title" style="text-align: left; margin-bottom: 20px;">@Model.Title</h1>
    </div>

    <img src="@Model.ImageUrl" alt="@Model.Title" class="article-main-image" />

    <div class="case-content">
        @Html.Raw(Model.FullContent)
    </div>
</article>

@if (similarCases != null && similarCases.Any())
{
    <div style="margin-bottom: 40px;">
        <h2 class="page-title" style="text-align: left; margin-bottom: 20px; font-size: 22px;">Похожие кейсы</h2>
        <div class="cases-grid">
            @foreach (var sim in similarCases.Take(2))
            {
                <div class="case-card">
                    <div class="case-card-body">
                        <h3 class="case-card-title" style="font-size: 16px;">@sim.Title</h3>
                        <p class="case-card-desc" style="font-size: 13px;">@sim.BriefDescription</p>
                        <a href="@Url.Action("Details", "Cases", new { alias = sim.Alias })" class="btn-primary" style="padding: 8px 16px; font-size: 13px;">Читать полностью</a>
                    </div>
                </div>
            }
        </div>
    </div>
}

<section class="review-section">
    <h2 class="page-title" style="text-align: left; margin-bottom: 10px; font-size: 22px;">Оставить отзыв</h2>
    <p style="color: #64748b; font-size: 14px; margin-bottom: 25px;">Ваше мнение важно для нас.</p>

    @if (ViewBag.SuccessMessage != null)
    {
        <div class="toast-notification success" id="toastNotice">@ViewBag.SuccessMessage</div>
    }
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="toast-notification error" id="toastNotice">@ViewBag.ErrorMessage</div>
    }

    <form action="" method="post" id="reviewForm">
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label class="form-label" for="Name">Ваше имя *</label>
            <input type="text" id="Name" name="Name" class="form-control" required />
            <span class="error-msg"></span>
        </div>

        <div class="form-group">
            <label class="form-label" for="Email">Электронная почта *</label>
            <input type="email" id="Email" name="Email" class="form-control" required />
            <span class="error-msg"></span>
        </div>

        <div class="form-group">
            <label class="form-label" for="Text">Текст отзыва *</label>
            <textarea id="Text" name="Text" rows="5" class="form-control" required></textarea>
            <span class="error-msg"></span>
        </div>

        <button type="submit" class="btn-primary" style="width: 100%; padding: 14px; cursor: pointer;">Отправить отзыв</button>
    </form>
</section>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const toast = document.getElementById('toastNotice');
        if (toast) {
            toast.style.display = 'block';
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateY(-20px)';
                setTimeout(() => toast.remove(), 500);
            }, 4000);
        }
    });
</script>